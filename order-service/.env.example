# Copy to .env and adjust. Every value below is the built-in default, so an
# empty .env behaves identically to this file except for the required ones.

# --- application ---------------------------------------------------------
APP_NAME=order-service
APP_ENV=local            # local | staging | production
APP_VERSION=dev

# --- http ----------------------------------------------------------------
PORT=8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=1m
HTTP_SHUTDOWN_TIMEOUT=15s
HTTP_CORS_ORIGINS=http://localhost:5173

# --- database (required: DB_DATABASE, DB_USERNAME) -----------------------
# The BLUEPRINT_DB_* names are still honoured as a fallback.
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=orders
DB_USERNAME=app
DB_PASSWORD=secret
DB_SCHEMA=public
DB_SSLMODE=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m
DB_CONNECT_TIMEOUT=5s

# --- observability -------------------------------------------------------
LOG_LEVEL=info           # debug | info | warn | error
LOG_FORMAT=json          # json | text
# Leave the endpoint empty to disable export. Spans are still created, so trace
# IDs keep appearing in logs.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_SERVICE_NAME=order-service
